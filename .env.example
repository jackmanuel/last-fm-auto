# Last.fm API Credentials (from https://www.last.fm/api/account/create)
LAST_FM_API_KEY="your_api_key_here"
LAST_FM_API_SECRET="your_api_secret_here"

# Last.fm Session Key (generated via: python -m last_fm_auto.main --authenticate)
LAST_FM_SESSION_KEY=""

# Path to the SQLite play history database (use forward slashes)
DATABASE_PATH="C:/path/to/your/database.db"

# The Discord Server/Guild ID to scrobble
GUILD_ID="your_discord_guild_id_here"

# Optional debug logging (True/False)
DEBUG_MODE="False"
