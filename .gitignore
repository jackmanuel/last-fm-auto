# ============================================================================
# .gitignore for the Last.fm Auto Scrobbler Project
# ============================================================================

# --- Secrets ---
# Never commit environment files. They contain API keys, passwords, and other secrets.
# This is the most important rule in this file.
.env
.env.*
!.env.example

# --- Python ---
# Ignore the Python cache directory, compiled files, and virtual environments.
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
env/
.venv/

# --- Build / Installation Artifacts ---
# Ignore artifacts created by installing the package with setup.py.
build/
dist/
*.egg-info/

# --- Data Files ---
# Ignore data files that are GENERATED by scripts or represent application STATE.
# Do NOT ignore source data files like `abbreviations.json` or `lastfmstats-*.csv`.

# Ignore application state databases. The schema should be in code, not the data.
data/*.db

# Ignore the local tracks file, as it is generated by a script
# from the source CSV files.
data/local_tracks*.json

# --- Evaluation & Caching ---
# Ignore files generated during the evaluation process, like cached API results
# and tuning output logs.

# Ignore the large JSON files that are caches of API search results.
evaluation/data/last_fm_search_results_*.json

# Ignore large data files
evaluation/data/*.csv
data/*.csv

# Ignore logs
logs/

# Ignore generated output files from tuning.
evaluation/data/*.txt

# --- IDE / Editor Specific ---
# Ignore settings specific to local development environments like VS Code.
.vscode/

# --- OS Specific ---
# Ignore macOS specific files
.DS_Store

# Ignore Windows thumbnail cache
Thumbs.db